---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResumeCta from '../components/ResumeCta.astro';
import { SITE, url } from '../site';

interface Props {
  title?: string;
  description?: string;
  // ヘッダーをヒーローに重ねるページで指定する
  overlayHeader?: boolean;
  // フッター上の職務経歴書への導線を出さないページで指定する
  hideResumeCta?: boolean;
}

const { title, description = SITE.description, overlayHeader = false, hideResumeCta = false } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.tagline}` : SITE.tagline;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    {SITE.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col bg-white font-sans text-gray-950 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only">
      本文へ移動
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideResumeCta && <ResumeCta />}
    <Footer />
    <script>
      import '../scripts/hero-light';
      import '../scripts/reveal';
    </script>
  </body>
</html>
