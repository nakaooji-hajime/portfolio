---
import ExternalLinkIcon from '@lucide/astro/icons/external-link';

interface Props {
  href: string;
  // 暗い面の上に置く場合に指定する
  overlay?: boolean;
}

const { href, overlay = false } = Astro.props;
// アイコンは文字の切り抜き（.text-fill）で透明にならないよう自分で色を持ち、文字が染まり終わるころに線の色を変える
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['group text-fill inline-flex items-center gap-1', overlay && 'text-fill-overlay']}
>
  <slot />
  <span class="sr-only">（新しいタブで開く）</span>
  <ExternalLinkIcon
    aria-hidden="true"
    class:list={[
      'size-4 shrink-0 transition-colors delay-200 duration-200 group-hover:stroke-teal-400 group-focus-visible:stroke-teal-400 motion-reduce:transition-none',
      overlay ? 'text-white' : 'text-gray-950',
    ]}
  />
</a>
