---
import Lead from './Lead.astro';

interface Props {
  lead?: string;
}

const { lead } = Astro.props;
---

<div class="flex flex-col gap-8">
  <h1 data-reveal class="text-4xl leading-snug font-bold text-gray-950 md:text-6xl">
    <slot />
  </h1>
  {lead && <Lead class="max-w-4xl">{lead}</Lead>}
</div>
