---
interface Props {
  lead?: string;
}

const { lead } = Astro.props;
---

<div class="flex flex-col gap-8">
  <h1 data-reveal class="text-4xl leading-snug font-bold md:text-6xl">
    <slot />
  </h1>
  {lead && (
    <p data-reveal class="max-w-4xl text-base leading-loose">
      {lead}
    </p>
  )}
</div>
