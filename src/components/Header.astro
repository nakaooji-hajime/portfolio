---
import { NAV, SITE, url } from '../site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === url() ? current === href : current.startsWith(href));
const fill = ['text-fill inline-block', overlay && 'text-fill-overlay'];
---

<header class:list={[overlay && 'hero-fade absolute inset-x-0 top-0 z-10 text-white']}>
  <div class="mx-auto flex flex-wrap items-center justify-between gap-4 px-6 py-6">
    <a href={url()} class:list={[fill, 'font-bold tracking-wide']}>
      {SITE.name}
    </a>
    <nav aria-label="メイン">
      <ul class="flex gap-6 text-sm">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={isCurrent(item.href) ? ['font-bold', overlay ? 'text-white' : 'text-gray-950'] : fill}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
