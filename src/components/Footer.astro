---
import { getCollection } from 'astro:content';
import { NAV, SITE, url } from '../site';

const featured = (await getCollection('works', (work) => work.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const link = 'text-fill text-fill-overlay inline-block';

const groups = [
  { heading: 'Menu', links: NAV },
  { heading: 'Works', links: featured.map((work) => ({ label: work.data.title, href: url(`works/${work.id}`) })) },
  {
    heading: 'Contact',
    links: [
      { label: 'GitHub', href: SITE.github },
      { label: '職務経歴書PDF', href: url(SITE.resumePdf) },
    ],
  },
];
---

<footer class="hero-bg relative isolate overflow-hidden text-gray-50">
  <canvas data-hero-light="solid" aria-hidden="true" class="absolute inset-0 -z-10 size-full"></canvas>
  <div class="mx-auto flex max-w-6xl flex-col gap-24 px-6 py-24">
    <div class="flex flex-col gap-8">
      <p class="text-4xl leading-snug font-bold md:text-8xl">
        Nakaooji
        <br />
        Hajime
      </p>
      <p class="text-base leading-loose md:text-lg">{SITE.tagline}</p>
    </div>
    <div class="grid gap-12 md:grid-cols-3">
      {groups.map((group) => (
        <nav aria-label={group.heading} class="flex flex-col gap-4">
          <h2 class="text-xs text-gray-500">{group.heading}</h2>
          <ul class="flex flex-col gap-4">
            {group.links.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-gray-500">
      <p>© {new Date().getFullYear()} Nakaooji Hajime</p>
      <a href="#main" class={link}>
        ページ上部へ戻る
      </a>
    </div>
  </div>
</footer>
