---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { url, workYear } from '../site';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, subtitle, role, period, thumbnail } = work.data;
---

<a
  href={url(`works/${work.id}`)}
  class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white transition-transform duration-500 hover:scale-102"
>
  <Image src={thumbnail} alt={`${title}のサムネイル`} class="aspect-video w-full object-cover" />
  <div class="flex flex-col gap-4 p-8">
    <div class="flex flex-col gap-2">
      <h3 class="text-lg leading-snug font-bold">
        <span class="text-fill inline-block">
          {title} - {subtitle}
        </span>
      </h3>
      <p class="text-xs leading-loose text-gray-500">制作時期：{workYear(period)}</p>
    </div>
    <TagList items={role.split(' / ')} />
  </div>
</a>
