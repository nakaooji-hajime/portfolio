---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../site';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, subtitle, role, summary, thumbnail } = work.data;
---

<article class="group relative flex flex-col">
  <div class="overflow-hidden border border-gray-200">
    <Image
      src={thumbnail}
      alt={`${title}のサムネイル`}
      class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>
  <h3 class="mt-4 text-lg font-bold text-gray-950">{title}</h3>
  <p class="mt-1 text-sm text-gray-600">{subtitle}</p>
  <p class="mt-3 text-sm text-gray-600">{role}</p>
  <p class="mt-3 font-bold text-gray-800">{summary}</p>
  <a
    href={url(`works/${work.id}`)}
    class="mt-4 text-sm text-gray-950 underline after:absolute after:inset-0"
    aria-label={`${title}の詳細を見る`}
  >
    詳細を見る
  </a>
</article>
