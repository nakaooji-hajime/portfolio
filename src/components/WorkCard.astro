---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { url } from '../site';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, subtitle, role, period, thumbnail } = work.data;
---

<article class="group relative h-full bg-white">
  <div class="overflow-hidden">
    <Image
      src={thumbnail}
      alt={`${title}のサムネイル`}
      class="aspect-video w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>
  <div class="p-6 md:p-8">
    <h3 class="text-lg leading-relaxed font-bold">
      <a href={url(`works/${work.id}`)} class="text-fill text-fill-touch inline-block after:absolute after:inset-0">
        {title} - {subtitle}
      </a>
    </h3>
    <p class="mt-2 text-sm text-gray-600">{period}</p>
    <div class="mt-4">
      <TagList items={role.split(' / ')} />
    </div>
  </div>
</article>
