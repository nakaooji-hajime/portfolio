---
import SkillIcon from './SkillIcon.astro';
import type { SkillIconName } from '../data/career';

interface Props {
  items: (string | { label: string; icon: SkillIconName })[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {items.map((item) =>
    typeof item === 'string' ? (
      <li class="bg-gray-100 px-3 py-1 text-sm text-gray-700">{item}</li>
    ) : (
      <li class="flex items-center gap-2 bg-gray-100 px-3 py-1 text-sm text-gray-700">
        <SkillIcon name={item.icon} class="size-4 shrink-0 text-gray-950" />
        {item.label}
      </li>
    ),
  )}
</ul>
