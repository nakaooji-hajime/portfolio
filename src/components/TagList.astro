---
import SkillIcon from './SkillIcon.astro';
import type { SkillIconName } from '../data/career';

interface Props {
  items: (string | { label: string; icon: SkillIconName })[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {items.map((item) =>
    typeof item === 'string' ? (
      <li class="rounded-sm bg-gray-50 px-2 py-1 text-xs text-gray-950">{item}</li>
    ) : (
      <li class="flex items-center gap-1 rounded-sm bg-gray-50 px-2 py-1 text-xs text-gray-950">
        <SkillIcon name={item.icon} class="size-4 shrink-0" />
        {item.label}
      </li>
    ),
  )}
</ul>
