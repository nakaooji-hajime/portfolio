---
import { SITE } from '../site';
---

<div class="intro fixed inset-0 z-50 grid place-items-center bg-white" aria-hidden="true">
  <span class="intro-logo text-2xl font-bold tracking-wide text-gray-950 md:text-3xl">{SITE.name}</span>
</div>
<section class="hero-bg relative flex h-svh min-h-96 flex-col justify-end overflow-hidden text-white">
  <canvas data-hero-light aria-hidden="true" class="absolute inset-0 size-full touch-pan-y"></canvas>
  <div class="relative mx-auto w-full max-w-6xl px-6 pb-16 md:pb-24">
    <h1 class="text-5xl leading-tight font-bold md:text-7xl md:leading-tight">
      <span class="hero-line block overflow-hidden"><span style="--i:0">新たな視点で</span></span>
      <span class="hero-line block overflow-hidden"><span style="--i:1">成果に繋げる</span></span>
    </h1>
    <p class="hero-sub mt-6 text-sm tracking-wide md:text-base">{SITE.name} UI/UX Portfolio Site</p>
  </div>
</section>

<script>
  import '../scripts/hero-light';
</script>
