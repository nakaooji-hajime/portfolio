---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className } = Astro.props;
---

<section id={id} class={className}>
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-40">
    <h2 data-reveal class="text-4xl font-bold text-gray-950 md:text-6xl">
      {title}
    </h2>
    <slot />
  </div>
</section>
