---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import TagList from '../components/TagList.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { career, skills } from '../data/career';
import profile from '../assets/profile.png';
import { url } from '../site';

const featured = (await getCollection('works', (work) => work.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base overlayHeader>
  <script is:inline slot="head">
    try {
      if (sessionStorage.getItem('intro-seen')) document.documentElement.classList.add('intro-seen');
      else sessionStorage.setItem('intro-seen', '1');
    } catch {
      // 保存できない環境では毎回ロゴの演出を再生する
    }
  </script>

  <Hero />

  <section class="relative isolate w-full overflow-hidden bg-white">
    <canvas data-hero-light aria-hidden="true" class="absolute inset-0 -z-10 size-full"></canvas>
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6 py-24">
      <h2 data-reveal class="text-4xl leading-snug font-bold md:text-6xl">
        前提を疑い、
        <br />
        新たな視点を持ち込む。
      </h2>
      <div class="flex max-w-4xl flex-col gap-8">
        <p data-reveal>
          キャリアを振り返ると、大きな成果につながったのは、いつも新しいことに挑戦したときでした。業界や組織の慣習からは思いつかず、ロジカルで規範的なAIの改善案からも出てこない。そんなアイデアに踏み出したときです。
        </p>
        <p data-reveal>
          「そんなことをやっていいのか」「前例がないから判断できない」。そうした声が上がる中で踏み出し、多くの失敗も重ねましたが、大きな成果も生み出してきました。
        </p>
        <p data-reveal>
          だからこそ、前提を疑い、新たな視点を事業の成果につなげることを大切に、デザインに取り組んでいます。
        </p>
      </div>
    </div>
  </section>

  <Section id="profile" class="scroll-mt-8 bg-gray-50" title="Profile">
    <div class="grid gap-12 md:grid-cols-3">
      <Image data-reveal src={profile} alt="中大路一のプロフィール写真" class="w-full max-w-xs rounded-lg" />
      <div class="flex flex-col gap-12 md:col-span-2">
        <p data-reveal>
          イラストレーターを経て、広告代理店や事業会社でWeb・アプリ・SaaSのプロダクトデザインに携わってきました。現在はGoensのCXOとして、シニア向けマッチングサービスのグロースに注力しています。デザインに加え、施策立案、データ分析、UXリサーチ、フロントエンド開発まで担い、事業の成長に貢献してきました。
        </p>
        <div data-reveal class="flex flex-col gap-8">
          <h3 class="text-2xl leading-snug font-bold">スキル</h3>
          <dl class="grid gap-4 md:grid-cols-2">
            {skills.map((skill) => (
              <div class="flex flex-col gap-4 rounded-3xl bg-white p-8">
                <dt class="text-2xl leading-snug font-bold">{skill.category}</dt>
                <dd>
                  <TagList items={skill.items} />
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </Section>

  <Section class="bg-white" title="Career">
    <ol class="flex flex-col gap-4">
      {career.map((item) => (
        <li data-reveal class="flex flex-col gap-2 rounded-3xl bg-gray-50 p-8 md:flex-row md:gap-8">
          <p class="text-2xl leading-snug whitespace-nowrap text-gray-500 md:w-24 md:shrink-0">{item.period}</p>
          <div class="flex flex-col gap-2">
            <h3 class="text-2xl leading-snug font-bold">{item.company}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section class="bg-gray-50" title="Works">
    <WorkGrid works={featured} />
    <Button data-reveal href={url('works')} class="self-start">
      すべての事例を見る
    </Button>
  </Section>
</Base>
