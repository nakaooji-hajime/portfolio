---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, url } from '../site';
---

<Base title="Resume" description="中大路一の職務経歴書（PDF）。">
  <div class="mx-auto max-w-4xl px-6 pt-16 md:pt-32">
    <PageHeader lead="これまでの経歴、担当範囲、実績をまとめた職務経歴書をPDFでご覧いただけます。">
      職務経歴書
    </PageHeader>
    <p data-reveal class="mt-12">
      <Button href={url(SITE.resumePdf)} download>
        PDFをダウンロード
      </Button>
    </p>
  </div>
</Base>
