---
import Download from '@lucide/astro/icons/download';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, url } from '../site';
---

<Base title="Resume" description="中大路一の職務経歴書（PDF）。" hideResumeCta>
  <section class="w-full bg-white">
    <div class="mx-auto flex max-w-4xl flex-col gap-12 px-6 py-24">
      <PageHeader lead="これまでの経歴、担当範囲、実績をまとめた職務経歴書（PDF）をご覧いただけます。">
        Resume
      </PageHeader>
      <Button data-reveal href={url(SITE.resumePdf)} download class="self-start">
        職務経歴書をダウンロード
        <Download aria-hidden="true" class="size-5" />
      </Button>
    </div>
  </section>
</Base>
