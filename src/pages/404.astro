---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../site';
---

<Base title="ページが見つかりません">
  <div class="mx-auto max-w-4xl px-6 pt-16 md:pt-32">
    <p data-reveal class="text-7xl font-bold text-gray-950 md:text-9xl">
      404
    </p>
    <div class="mt-8">
      <PageHeader>ページが見つかりません</PageHeader>
    </div>
    <p data-reveal class="mt-12">
      <a
        href={url()}
        class="inline-block bg-gray-950 px-8 py-4 font-bold text-white transition-colors hover:bg-gray-700"
      >
        ホームへ戻る
      </a>
    </p>
  </div>
</Base>
