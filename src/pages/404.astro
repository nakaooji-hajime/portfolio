---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../site';
---

<Base title="ページが見つかりません" hideResumeCta>
  <section class="w-full bg-white">
    <div class="mx-auto flex max-w-4xl flex-col gap-12 px-6 py-24">
      <p data-reveal class="text-4xl leading-snug font-bold text-gray-950 md:text-8xl">
        404
      </p>
      <PageHeader>ページが見つかりません</PageHeader>
      <Button data-reveal href={url()} class="self-start">
        ホームへ戻る
      </Button>
    </div>
  </section>
</Base>
