---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PanelLink from '../../components/PanelLink.astro';
import ProvisionalNote from '../../components/ProvisionalNote.astro';
import { url } from '../../site';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
  return works.map((work, index) => ({
    params: { slug: work.id },
    props: { work, prev: works[index - 1], next: works[index + 1] },
  }));
}

interface Props {
  work: CollectionEntry<'works'>;
  prev?: CollectionEntry<'works'>;
  next?: CollectionEntry<'works'>;
}

const { work, prev, next } = Astro.props;
const { title, subtitle, summary, company, role, period, provisional, thumbnail, metrics } = work.data;
const { Content } = await render(work);
---

<Base title={title} description={`${title} - ${subtitle}。${summary}`}>
  <article>
    <div class="mx-auto max-w-6xl px-6 pt-8 md:pt-16">
      {provisional && <ProvisionalNote />}
      <div data-reveal class="mt-8 overflow-hidden border border-gray-200">
        <Image src={thumbnail} alt={`${title}のサムネイル`} loading="eager" class="aspect-video w-full object-cover" />
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-6">
      <div class="mt-12 md:mt-24">
        <PageHeader lead={subtitle}>{title}</PageHeader>
      </div>
      <dl data-reveal class="mt-12 grid gap-6 border-y border-gray-200 py-8 text-sm md:grid-cols-3">
        <div>
          <dt class="text-gray-600">所属</dt>
          <dd class="mt-1 leading-relaxed text-gray-950">{company}</dd>
        </div>
        <div>
          <dt class="text-gray-600">役割</dt>
          <dd class="mt-1 leading-relaxed text-gray-950">{role}</dd>
        </div>
        <div>
          <dt class="text-gray-600">期間</dt>
          <dd class="mt-1 leading-relaxed text-gray-950">{period}</dd>
        </div>
      </dl>
      <dl class:list={['mt-12 grid gap-4', metrics.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3']}>
        {metrics.map((metric, i) => (
          <div
            data-reveal
            class:list={[
              'flex min-h-48 flex-col-reverse justify-between gap-8 p-8',
              i === 0 ? 'bg-gray-950 text-white' : 'bg-gray-100 text-gray-950',
            ]}
          >
            <dt class:list={['text-sm leading-relaxed', i === 0 ? 'text-gray-300' : 'text-gray-700']}>
              {metric.label}
            </dt>
            <dd class="text-3xl leading-tight font-bold">{metric.value}</dd>
          </div>
        ))}
      </dl>
      <div class="case-body">
        <Content />
      </div>
    </div>

    <nav aria-label="前後のWorks" class="mx-auto mt-24 max-w-6xl px-6 md:mt-40">
      <div class="grid gap-4 md:grid-cols-2">
        {prev ? (
          <PanelLink data-reveal href={url(`works/${prev.id}`)}>
            <span class="text-sm text-gray-700">← 前の事例</span>
            <span class="mt-2 block text-2xl font-bold text-gray-950">{prev.data.title}</span>
          </PanelLink>
        ) : (
          <span class="hidden md:block" />
        )}
        {next && (
          <PanelLink data-reveal href={url(`works/${next.id}`)} class="text-right">
            <span class="text-sm text-gray-700">次の事例 →</span>
            <span class="mt-2 block text-2xl font-bold text-gray-950">{next.data.title}</span>
          </PanelLink>
        )}
      </div>
      <p class="mt-8 text-center">
        <a href={url('works')} class="text-gray-950 underline">
          Works一覧へ戻る
        </a>
      </p>
    </nav>
  </article>
</Base>
