---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import WorkGrid from '../../components/WorkGrid.astro';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const featured = works.filter((work) => work.data.featured);
const others = works.filter((work) => !work.data.featured);
---

<Base title="Works" description="UI/UXデザイナー中大路一が携わったプロダクトの一覧。">
  <section class="w-full bg-gray-50">
    <div class="mx-auto flex max-w-6xl flex-col gap-24 px-6 py-24">
      <PageHeader lead="これまでに携わったプロダクトと、そこで生んだ成果をまとめています。">Works</PageHeader>

      <section class="flex flex-col gap-8">
        <h2 data-reveal class="text-2xl leading-snug font-bold text-gray-950">
          主要な事例
        </h2>
        <WorkGrid works={featured} />
      </section>

      <section class="flex flex-col gap-8">
        <h2 data-reveal class="text-2xl leading-snug font-bold text-gray-950">
          その他の事例
        </h2>
        <WorkGrid works={others} dense />
      </section>
    </div>
  </section>
</Base>
